{{ 'marmeto-countdown-timer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'marmeto-countdown-timer.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<marmeto-countdown-timer
  class="section-{{ section.id }}"
  data-countdown-timezone="{{ "now" | date: "%z" }}"
  data-countdown-day="{{ section.settings.countdown_day }}"
  data-countdown-month="{{ section.settings.countdown_month }}"
  data-countdown-year="{{ section.settings.countdown_year }}"
  data-countdown-hour="{{ section.settings.countdown_hour }}"
  data-countdown-minute="{{ section.settings.countdown_minute }}"
  data-disable-section="{{ section.settings.disable_on_completion }}"
>
  <div class="marmeto-countdown-timer">
    <div class="page-width">
      <div class="marmeto-countdown-timer__header">
        {% if section.settings.subheading_text != blank %}
          <p class="marmeto-countdown-timer__subheading">
            {{ section.settings.subheading_text }}
          </p>
        {% endif %}

        {% if section.settings.heading_text != blank %}
          <h2 class="marmeto-countdown-timer__heading">
            {{ section.settings.heading_text }}
          </h2>
        {% endif %}
      </div>

      <div class="marmeto-countdown-timer__flex">
        <div class="marmeto-countdown-timer__flexitem">
          <div class="marmeto-countdown-timer__dynamic" countdown-days-text>00</div>
          <div class="marmeto-countdown-timer__static">Days</div>
        </div>
        <div class="marmeto-countdown-timer__flexitem">
          <div class="marmeto-countdown-timer__dynamic" countdown-hours-text>00</div>
          <div class="marmeto-countdown-timer__static">Hours</div>
        </div>
        <div class="marmeto-countdown-timer__flexitem">
          <div class="marmeto-countdown-timer__dynamic" countdown-minutes-text>00</div>
          <div class="marmeto-countdown-timer__static">Minutes</div>
        </div>
        <div class="marmeto-countdown-timer__flexitem">
          <div class="marmeto-countdown-timer__dynamic" countdown-seconds-text>00</div>
          <div class="marmeto-countdown-timer__static">Seconds</div>
        </div>
      </div>
    </div>
  </div>
</marmeto-countdown-timer>

